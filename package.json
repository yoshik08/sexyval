{
  "name": "sexyval",
  "productName": "SexyVal",
  "version": "1.3.2",
  "description": "SexyVal",
  "main": "dist-electron/main/main.js",
  "author": "yoshik",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:helper && npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/run-electron.mjs",
    "mock": "npm run build && node scripts/run-electron.mjs MOCK=1",
    "mock:server": "npm run build:main && node dist-electron/mock/standalone.js",
    "screenshots": "npm run build && node scripts/run-electron.mjs MOCK=1 SEXYVAL_SCREENSHOTS=screenshots",
    "icon": "node scripts/make-icon.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "mock:update": "node scripts/mock-update-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "dist": "npm run icon && npm run build:helper && npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "gsap": "^3.12.5",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
